# ============================================================
# Einstein AI V2 — Git Ignore
# ============================================================

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd

# Virtual environments
.venv/
venv/
env/

# Jupyter
.ipynb_checkpoints/

# Testing
.pytest_cache/
.coverage
htmlcov/

# Type checking
.mypy_cache/

# Ruff
.ruff_cache/

# Secrets
.env
.env.*
*.secret

# OS
.DS_Store
Thumbs.db

# Large datasets
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

# Model files
models/*
!models/.gitkeep

# Generated artifacts
artifacts/*
!artifacts/.gitkeep

# Runtime logs
logs/*
!logs/.gitkeep

# Local Colab files
/content/
